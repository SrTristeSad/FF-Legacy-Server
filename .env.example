NODE_ENV=production
LOG_LEVEL=info

LIVE_PORT=19134
LOGIN_PORT=19132
MAIN_PORT=19133
ROOMS_PORT=19135
TCP_PORT=8084
GAME_SERVER_PORT=10100

# Keep services loopback-only by default. Set to 0.0.0.0 only while testing
# from an external emulator/device and protect the VPS with firewall rules.
BIND_HOST=127.0.0.1

POSTGRES_USER=ff
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fflegacy
DATABASE_URL=postgres://ff:change-me@postgres:5432/fflegacy?sslmode=disable
REDIS_URL=redis://redis:6379

# Public IP or hostname advertised back to the legacy client.
PUBLIC_HOST=127.0.0.1
GAME_VERSION=1.70.0
SESSION_TTL_SEC=28800

# Optional explicit URLs returned by /ver.php. When blank, live.js derives
# them from PUBLIC_HOST + the ports above.
CLIENT_LOGIN_URL=
CLIENT_CDN_URL=
CLIENT_COUNTRY_CODE=BR
REMOTE_OPTION_VERSION=

# setup.sh replaces these development values when it initializes the server.
MATCH_HANDOFF_SECRET=dev-change-me
MATCH_RESULT_SECRET=dev-change-me-result
